{
  "name": "heya-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi generate",
    "generate:api": "bun install --cwd tools/api-codegen --frozen-lockfile && bun run --cwd tools/api-codegen generate",
    "typecheck": "bun run typecheck:ts && bun run typecheck:vue",
    "typecheck:ts": "tsc --noEmit -p .nuxt/tsconfig.json",
    "typecheck:vue": "bun install --cwd tools/vue-typecheck --frozen-lockfile && bun run --cwd tools/vue-typecheck check",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@nuxt/image": "^2.1.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/colada-plugin-auto-refetch": "^0.2.6",
    "@pinia/colada-plugin-retry": "^1.0.2",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "akarisub": "^0.2.2",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "hls.js": "^1.7.1",
    "nuxt": "^4.5.2",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.3",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/colada-devtools": "^1.1.2",
    "@types/node": "^26.2.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "typescript": "7.0.2"
  }
}
